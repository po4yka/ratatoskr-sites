# Operator example for ratatoskr-sites, a systemd EnvironmentFile (EnvironmentFile=/etc/ratatoskr/sites.conf).
# Copy it to /etc/ratatoskr/sites.conf, replace every CHANGE-ME, and keep the file readable by the service user only.
# `ratatoskr-sites check-config` validates it without starting anything (exit 0 valid, exit 78 invalid).

# Operator listener: /health/live, /health/ready, /metrics, /version. Host only; allocated in docs/DEPLOYMENT_TARGET.md of ratatoskr-workspace.
RATATOSKR__ADMIN__BIND=127.0.0.1:9472

# Domain API (/v1/sites). Loopback; Edge is the only client, also for the anonymous content routes. Allocated in docs/DEPLOYMENT_TARGET.md of ratatoskr-workspace.
RATATOSKR__API__LISTEN_ADDRESS=127.0.0.1:8100

# SECRET: the URL carries the password.
# The shared database `ratatoskr` and the role `ratatoskr_sites`, which deploy/postgres/role.sql creates (a PostgreSQL administrator runs it once, then sets the password with `\password ratatoskr_sites`). The service creates its own schema, `sites`, on the first start.
RATATOSKR__DATABASE__URL=postgres://ratatoskr_sites:CHANGE-ME@127.0.0.1:5432/ratatoskr

RATATOSKR__TELEMETRY__LOG_FORMAT=json

# The notes domain listener, loopback only. The build reads the index of each vault connection from
# GET /internal/connections/{connection}/files there.
RATATOSKR__NOTES__BASE_URL=http://127.0.0.1:8099

# The NATS server and the seed of the SITES identity (deploy/nats/identity.conf). Every connection
# uses the inbox prefix _INBOX_sites, the only one that the identity may subscribe to. The seed file
# is mode 0400, owner ratatoskr-sites.
RATATOSKR__BUS__URL=nats://127.0.0.1:4222
RATATOSKR__BUS__NKEY_SEED_PATH=/etc/ratatoskr/sites.nkey

# The sites tree (SITE-026): the bundles, the current and previous links and site.json of each site.
# The service is its only writer; ratatoskr-sites-gateway reads it through the group
# ratatoskr-sites-bundles. A bundle is at most RATATOSKR__DEPLOYS__MAX_BUNDLE_BYTES (default 64 MiB),
# and a site keeps RATATOSKR__DEPLOYS__RETENTION deploys (default 5).
RATATOSKR__DEPLOYS__ROOT=/mnt/nvme/ratatoskr/sites
