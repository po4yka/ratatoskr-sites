[Unit]
Description=Ratatoskr sites gateway
Documentation=https://github.com/po4yka/ratatoskr-sites/blob/main/deploy/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
# Stopped and restarted with the rest of the deployment; see ratatoskr.target in ratatoskr-platform.
PartOf=ratatoskr.target

[Service]
Type=exec
# The user and its group come from deploy/sysusers.d/ratatoskr-sites-gateway.conf.
User=ratatoskr-sites-gateway
Group=ratatoskr-sites-gateway
EnvironmentFile=/etc/ratatoskr/sites-gateway.conf
ExecStartPre=/usr/local/bin/ratatoskr-sites-gateway check-config
ExecStart=/usr/local/bin/ratatoskr-sites-gateway
Restart=always
RestartSec=10s
KillSignal=SIGTERM
# The gateway drains its connections for at most 10 seconds after SIGTERM.
TimeoutStopSec=20s

StandardOutput=append:/mnt/nvme/ratatoskr/logs/sites-gateway.log
StandardError=append:/mnt/nvme/ratatoskr/logs/sites-gateway.log

# Starting values to measure on the host, not results (workspace design D8).
MemoryHigh=96M
MemoryMax=128M
CPUQuota=100%
TasksMax=64

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
# `ratatoskr` is the shared group of every Ratatoskr unit (/etc/ratatoskr and the log directory).
# `ratatoskr-sites-bundles` is the read group of the sites tree: the root is 2750, each deploy
# directory 2750 and each file 0640 with that group, so the gateway reads the deploys and the
# projection and never writes them. The host role of ratatoskr-workspace creates the group.
SupplementaryGroups=ratatoskr ratatoskr-sites-bundles
# The sites tree is the only data the gateway reads; it writes nothing on disk.
ReadOnlyPaths=/mnt/nvme/ratatoskr/sites

[Install]
WantedBy=ratatoskr.target
